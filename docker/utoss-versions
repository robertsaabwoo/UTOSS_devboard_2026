#!/bin/sh
# Print the toolchain versions in this image. Run it when a bench behaves
# differently on your machine than in CI -- the answer is usually here.
set -e
iverilog -V 2>/dev/null | head -1
verilator --version
python3 --version
python3 -c 'import cocotb; print("cocotb", cocotb.__version__)'
if command -v yosys >/dev/null 2>&1; then
    yosys -V
else
    echo 'yosys: not in this image (build --target synth)'
fi
if command -v nextpnr-ecp5 >/dev/null 2>&1; then
    nextpnr-ecp5 --version 2>&1 | head -1
else
    echo 'nextpnr-ecp5: not installed (place-and-route checks will skip)'
fi
